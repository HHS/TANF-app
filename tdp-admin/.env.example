# Copy this file to `.env` for Docker Compose, or `.env.local` for `yarn dev`.

# Django auth origin used by server-side Next.js routes.
NEXT_PUBLIC_AUTH_URL=http://localhost:8989

# Browser-reachable auth origin used for login and logout redirects.
# When running the admin app in Docker, keep this as localhost and set
# NEXT_PUBLIC_AUTH_URL to http://host.docker.internal:8989.
NEXT_PUBLIC_AUTH_BROWSER_URL=http://localhost:8989

# Django API base used by health checks and /api/admin/* proxy requests.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8989/v1

# Admin-only Django API base used by the server-side /api/admin/* proxy.
# Defaults to deriving /admin-api/v1 from NEXT_PUBLIC_BACKEND_URL when unset.
ADMIN_BACKEND_URL=http://localhost:8989/admin-api/v1

# Browser origin allowed to send mutating /api/admin/* requests.
ADMIN_FRONTEND_ORIGIN=http://localhost:3001

# Shared server-side token required by Django for /admin-api/* requests.
# Set the same value in the Django backend environment.
ADMIN_API_PROXY_TOKEN=local-admin-proxy-token
