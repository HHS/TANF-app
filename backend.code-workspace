{
  "folders": [
    {
      "name": "Backend (Django & Celery)",
      "path": "tdrs-backend"
    },
    {
      "name": "Parser Service (Go)",
      "path": "tdrs-services/parser"
    }
  ],
  "settings": {
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.associations": {
      "Pipfile": "toml",
      "Pipfile.lock": "json",
      "docker-compose*.yml": "yaml"
    },
    // "python.linting.enabled": true,
    // "python.linting.flake8Enabled": true,
    // "python.testing.pytestEnabled": true,
    // "python.testing.unittestEnabled": false,
    // "python.testing.pytestArgs": [
    //   "tdpservice/test"
    // ],
    "files.exclude": {
      "**/node_modules": true
    }
  },
  "extensions": {
    "recommendations": [
      "batisteo.vscode-django",
      "circleci.circleci",
      "DavidAnson.vscode-markdownlint",
      "eamodio.gitlens",
      "editorconfig.editorconfig",
      "golang.go",
      "google.google-antigravity",
      "ms-azuretools.vscode-containers",
      "ms-azuretools.vscode-docker",
      "ms-ossdata.vscode-pgsql",
      "ms-python.black-formatter",
      "ms-python.flake8",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-vscode-remote.remote-containers",
      "ms-vscode.remote-repositories",
      "ms-vsliveshare.vsliveshare",
      "redhat.vscode-yaml",
      "streetsidesoftware.code-spell-checker",
      "task.vscode-task"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Backend: Start Web Server",
        "type": "shell",
        "command": "task backend-up",
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "dedicated" },
        "group": { "kind": "build", "isDefault": true }
      },
      {
        "label": "Backend: Stop Web Server",
        "type": "shell",
        "command": "task backend-down",
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "dedicated" }
      },
      {
        "label": "Backend: Restart Web Server",
